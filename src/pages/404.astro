---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="页面没有找到。">
  <section class="not-found container">
    <div>
      <p class="eyebrow">404</p>
      <h1>页面没有找到</h1>
      <p>这个地址暂时没有对应内容，可以回到首页或文章列表继续浏览。</p>
      <div class="hero-actions">
        <a class="button" href="/">回到首页</a>
        <a class="button-secondary" href="/blog/">查看文章</a>
      </div>
    </div>
  </section>
</BaseLayout>
