---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { sortPosts } from '../lib/blog';
import { SITE } from '../lib/site';
import { projects } from '../data/projects';

const posts = sortPosts(
  await getCollection('blog', ({ data }) => data.draft !== true)
).slice(0, 3);
---

<BaseLayout title="首页" description={SITE.description}>
  <section class="home-hero">
    <div class="container hero-content">
      <p class="eyebrow">Algorithm / 408 / AI / Project</p>
      <h1>Hone7 Blog</h1>
      <p class="lead">
        Hone，一个 AI 专业学生，关注算法竞赛、408 考研、AI 学习和个人软件项目。这里记录可复盘的学习过程、工程实践和阶段性思考。
      </p>
      <div class="hero-actions">
        <a class="button" href="/blog/">阅读文章</a>
        <a class="button-secondary" href="/projects/">查看项目</a>
      </div>
      <ul class="hero-points" aria-label="博客方向">
        <li>算法竞赛训练</li>
        <li>408 考研笔记</li>
        <li>AI 专业学习</li>
        <li>项目开发记录</li>
      </ul>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Recent Writing</p>
        <h2>最近文章</h2>
      </div>
      <a class="text-link" href="/blog/">查看全部</a>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} compact />)}
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projects</p>
        <h2>精选项目</h2>
      </div>
      <p>把课程、考试和算法训练中的真实需求拆成可以长期维护的小工具。</p>
    </div>
    <div class="project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Learning Map</p>
        <h2>学习坐标</h2>
      </div>
    </div>
    <div class="focus-grid">
      <article class="info-panel">
        <h3>算法竞赛</h3>
        <p>重点整理动态规划、图论、字符串、数据结构和训练复盘，保留题目背后的状态设计与复杂度分析。</p>
      </article>
      <article class="info-panel">
        <h3>408 与 AI</h3>
        <p>将计算机基础、数学推导、机器学习和工程实现串起来，用笔记沉淀长期可检索的知识网络。</p>
      </article>
    </div>
  </section>
</BaseLayout>
