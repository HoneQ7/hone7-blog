---
interface Project {
  name: string;
  status: string;
  description: string;
  stack: string[];
  link: string;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-card-top">
    <h2>{project.name}</h2>
    <span>{project.status}</span>
  </div>
  <p>{project.description}</p>
  <ul class="tech-list" aria-label={`${project.name} 技术栈`}>
    {project.stack.map((item) => <li>{item}</li>)}
  </ul>
  <a class="text-link" href={project.link}>查看记录</a>
</article>
